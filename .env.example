# Apple Music (heavy rotation on the Now page). Copy to .env and fill in.
# Team ID and a MusicKit key (Key ID + .p8 file) from developer.apple.com → Certificates, IDs & Profiles → Keys.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Path to the .p8 file inside the repo folder (git-ignored), or paste the key into APPLE_MUSIC_PRIVATE_KEY with \n for newlines.
APPLE_MUSIC_PRIVATE_KEY_FILE=.secrets/AuthKey.p8
# Filled in by `make music-token`.
APPLE_MUSIC_USER_TOKEN=
