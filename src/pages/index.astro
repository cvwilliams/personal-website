---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/home.css';
import { site } from '../data/site';
import { currentRole } from '../data/resume';
import { getThoughts, getProjects, getNowUpdates, formatDate } from '../lib/content';

const [latestThought] = await getThoughts();
const projects = (await getProjects()).slice(0, 3);
const [now] = await getNowUpdates();
---

<Base skipLink={false}>
  <script is:inline slot="head">
    (() => {
      const parts = [
        ['', 'field'],
        ['h2', 'title'],
        ['.tile-art', 'art'],
        ['.tile-body', 'tile-body'],
        ['.tile-arrow', 'tile-arrow'],
      ];
      const sectionOf = (url) => {
        const target = new URL(url, location.href);
        if (target.origin !== location.origin) return undefined;
        return target.pathname.match(/^\/(now|projects|thoughts|resume)(?:[/.]|$)/)?.[1];
      };
      const clear = () => {
        document.querySelectorAll('.tile, .tile *').forEach((el) => el.style.removeProperty('view-transition-name'));
        document.querySelectorAll('.tile.vt-active').forEach((el) => el.classList.remove('vt-active'));
      };
      const name = (section) => {
        clear();
        const tile = document.querySelector(`.tile[data-section="${section}"]`);
        if (!tile) return;
        tile.classList.add('vt-active');
        parts.forEach(([selector, prefix]) => {
          const el = selector ? tile.querySelector(selector) : tile;
          el?.style.setProperty('view-transition-name', `${prefix}-${section}`);
        });
      };
      document.addEventListener('click', (event) => {
        const tile = event.target instanceof Element ? event.target.closest('.tile') : null;
        if (tile && !event.defaultPrevented) name(tile.dataset.section);
      });
      addEventListener('pageswap', (event) => {
        const url = event.activation?.entry?.url;
        const section = event.viewTransition && url && sectionOf(url);
        if (section) name(section);
      });
      addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        const navigation = /** @type {any} */ (window).navigation;
        const from = navigation?.activation?.from?.url ?? document.referrer;
        const section = from && sectionOf(from);
        if (section) name(section);
        event.viewTransition.finished.finally(clear);
      });
    })();
  </script>
  <main id="main" class="tiles" tabindex="-1">
    <header class="badge">
      <div class="badge-text">
        <h1>{site.name}</h1>
        <p class="badge-meta">
          <span>{site.intro}</span>
          <span class="badge-dot" aria-hidden="true">·</span>
          <span class="clock" data-clock>New York</span>
        </p>
      </div>
      <ThemeToggle />
    </header>

    <Tile section="now" href="/now" title="Now">
      {
        now ? (
          <>
            <p class="eyebrow">
              <span class="dot" aria-hidden="true"></span>
              Updated {formatDate(now.data.updated, 'short')}
            </p>
            <p class="tile-lead">{now.data.focus}</p>
          </>
        ) : (
          <p class="tile-lead">What I'm working on right now</p>
        )
      }
    </Tile>

    <Tile section="projects" href="/projects" title="Projects">
      {
        projects.length > 0 ? (
          <ul class="mini-list">
            {projects.map((p) => (
              <li>
                <span>{p.data.title}</span>
                <span class="year">{p.data.year}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="tile-lead">Things I've built</p>
        )
      }
    </Tile>

    <Tile section="thoughts" href="/thoughts" title="Thoughts">
      {
        latestThought ? (
          <>
            <p class="eyebrow">Latest · {formatDate(latestThought.data.pubDate, 'short')}</p>
            <p class="tile-lead">{latestThought.data.title}</p>
          </>
        ) : (
          <p class="tile-lead">Things I keep thinking about</p>
        )
      }
    </Tile>

    <Tile section="resume" href="/resume" title="Resume">
      {
        currentRole ? (
          <>
            <p class="eyebrow">Currently</p>
            <p class="tile-lead">
              {currentRole.title} at {currentRole.company}
            </p>
          </>
        ) : (
          <p class="tile-lead">Experience, skills and education</p>
        )
      }
    </Tile>
  </main>

  <div class="home-footer">
    <SiteFooter />
  </div>

  <script>
    const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
    const format = new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'America/New_York',
    });
    const tick = () => {
      const text = `${format.format(new Date())} in New York`;
      clocks.forEach((el) => (el.textContent = text));
    };
    tick();
    setTimeout(
      () => {
        tick();
        setInterval(tick, 60_000);
      },
      60_000 - (Date.now() % 60_000),
    );
  </script>

  <script>
    const finePointer = window.matchMedia('(pointer: fine)');

    const saveDrag = (svg: SVGSVGElement, shape: SVGGraphicsElement, offset: { x: number; y: number }) => {
      try {
        const state = JSON.parse(sessionStorage.getItem('art-state') || '{}');
        const art = state[svg.dataset.art ?? ''];
        if (!art || shape.dataset.i === undefined) return;
        art.drags[shape.dataset.i] = [Math.round(offset.x * 10) / 10, Math.round(offset.y * 10) / 10];
        sessionStorage.setItem('art-state', JSON.stringify(state));
      } catch {}
    };
    const DRAG_THRESHOLD = 4;

    document.querySelectorAll<SVGSVGElement>('.tile-art').forEach((svg) => {
      const tile = svg.closest('a');
      let suppressClick = false;
      svg.addEventListener('dragstart', (event) => event.preventDefault());

      tile?.addEventListener(
        'click',
        (event) => {
          if (suppressClick) {
            event.preventDefault();
            suppressClick = false;
          }
        },
        true,
      );

      svg.querySelectorAll<SVGGraphicsElement>('rect, circle, path').forEach((shape) => {
        shape.classList.add('draggable');
        let start: { x: number; y: number; dx: number; dy: number } | null = null;
        let offset = { x: Number(shape.dataset.dx ?? 0), y: Number(shape.dataset.dy ?? 0) };
        let dragging = false;

        shape.addEventListener('pointerdown', (event) => {
          if (!finePointer.matches || event.button !== 0) return;
          event.preventDefault();
          shape.setPointerCapture(event.pointerId);
          start = { x: event.clientX, y: event.clientY, dx: offset.x, dy: offset.y };
          dragging = false;
        });

        shape.addEventListener('pointermove', (event) => {
          if (!start) return;
          const moved = Math.hypot(event.clientX - start.x, event.clientY - start.y);
          if (!dragging && moved < DRAG_THRESHOLD) return;
          if (!dragging) {
            dragging = true;
            shape.classList.add('is-dragging');
            shape.parentNode?.appendChild(shape);
          }
          const scale = 200 / svg.getBoundingClientRect().width;
          offset = {
            x: start.dx + (event.clientX - start.x) * scale,
            y: start.dy + (event.clientY - start.y) * scale,
          };
          shape.style.setProperty('translate', `${offset.x}px ${offset.y}px`);
        });

        const end = () => {
          if (dragging) {
            suppressClick = true;
            saveDrag(svg, shape, offset);
          }
          start = null;
          dragging = false;
          shape.classList.remove('is-dragging');
        };
        shape.addEventListener('pointerup', end);
        shape.addEventListener('pointercancel', end);
      });
    });
  </script>
</Base>
