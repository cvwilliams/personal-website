---
import { render, type CollectionEntry } from 'astro:content';
import Section from '../../layouts/Section.astro';
import Arrow from '../../components/Arrow.astro';
import { getThoughts, formatDate, readingTime } from '../../lib/content';
import { site } from '../../data/site';
import { blogPosting, jsonLd, person } from '../../lib/structured-data';

export async function getStaticPaths() {
  const thoughts = await getThoughts();
  return thoughts.map((thought) => ({ params: { slug: thought.id }, props: { thought } }));
}

interface Props {
  thought: CollectionEntry<'thoughts'>;
}

const { thought } = Astro.props;
const { Content } = await render(thought);
const { title, description, pubDate, updatedDate, tags } = thought.data;
const structuredData = jsonLd(blogPosting({ slug: thought.id, title, description, pubDate, updatedDate, tags }), person);
---

<Section
  section="thoughts"
  heading={title}
  intro={description}
  ogType="article"
  ogImage={{ src: `/og/${thought.id}.png`, alt: `${title} · ${site.name}` }}
  article
>
  <script is:inline slot="head" type="application/ld+json" set:html={structuredData} />

  <a slot="eyebrow" class="back" href="/thoughts">
    <Arrow direction="left" class="back-arrow" />
    Thoughts
  </a>

  <p slot="hero" class="facts mono">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>{' '}
    {readingTime(thought.body)} min read{' '}
    {
      updatedDate && (
        <span>
          Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
        </span>
      )
    }
  </p>

  <div class="prose">
    <Content />
  </div>

  {
    tags.length > 0 && (
      <footer class="tags">
        <ul class="chips" aria-label="Tags">
          {tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </footer>
    )
  }
</Section>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.back-arrow) {
    width: 14px;
    height: 14px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 8px 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .tags {
    margin: 48px 0 0;
  }
</style>
