---
import Section from '../../layouts/Section.astro';
import { getThoughts, formatDate, readingTime } from '../../lib/content';

const thoughts = await getThoughts();
---

<Section section="thoughts" heading="Thoughts" intro="Things I keep thinking about.">
  <a slot="hero" class="rss mono" href="/rss.xml">RSS feed</a>

  {
    thoughts.length === 0 ? (
      <p class="empty">Nothing published yet.</p>
    ) : (
      <ol class="list">
        {thoughts.map((e) => (
          <li>
            <a class="row" href={`/thoughts/${e.id}`}>
              <time class="date mono" datetime={e.data.pubDate.toISOString()}>
                {formatDate(e.data.pubDate, 'short')}
              </time>
              <div class="text">
                <h2>
                  {e.data.title}
                  {e.data.draft && <span class="draft mono">Draft</span>}
                </h2>
                <p class="desc">{e.data.description}</p>
              </div>
              <span class="mins mono">{readingTime(e.body)} min</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Section>

<style>
  .rss {
    align-self: flex-start;
    margin-top: 6px;
    font-size: 13px;
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 24px;
    padding: 24px 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }
  li:last-child .row {
    border-bottom: 1px solid var(--border);
  }
  .date {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--accent);
  }
  .text {
    min-width: 0;
  }
  h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    transition: color 0.2s;
  }
  .row:hover h2 {
    color: var(--accent);
  }
  .desc {
    margin: 6px 0 0;
    color: var(--muted);
  }
  .mins {
    font-size: 13px;
    color: var(--muted);
    padding-top: 4px;
  }
  .draft {
    margin-left: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px dashed var(--accent);
    font-size: 11px;
    color: var(--accent);
    vertical-align: middle;
  }
  @media (min-width: 720px) {
    .row {
      grid-template-columns: 140px 1fr auto;
    }
    .date {
      grid-column: auto;
      padding-top: 4px;
    }
  }
</style>
