---
import { getCollection, render } from 'astro:content';
import Section from '../layouts/Section.astro';
import Arrow from '../components/Arrow.astro';
import Reading from '../components/Reading.astro';
import Listening from '../components/Listening.astro';
import Spanish from '../components/Spanish.astro';
import { getNowUpdates, formatDate } from '../lib/content';

const [now, ...archived] = await getNowUpdates();
if (!now) throw new Error('Add a Now update in src/content/now/');
const { Content } = await render(now);
const synced = (await getCollection('reading')).map((book) => book.data);
const books = synced.length > 0 ? synced : now.data.reading;
const rotation = (await getCollection('listening')).map((item) => item.data);
const listening = rotation.length > 0 ? rotation : now.data.listening;
---

<Section section="now" heading="Now" intro={now.data.focus} description="What I'm working on right now.">
  <span slot="eyebrow" class="updated">
    <span class="dot" aria-hidden="true"></span>
    Updated <time datetime={now.data.updated.toISOString()}>{formatDate(now.data.updated)}</time>
  </span>

  <article class="prose">
    <Reading books={books} />
    <Listening items={listening} />
    {now.data.spanish && <Spanish hours={now.data.spanish.hours} note={now.data.spanish.note} />}
    <Content />
  </article>

  {
    archived.length > 0 && (
      <a class="archive-link" href="/now/archive">
        Previous Now pages ({archived.length})
        <Arrow class="archive-arrow" />
      </a>
    )
  }
</Section>

<style>
  .updated {
    display: contents;
  }
  .archive-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 48px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.3s var(--ease-soft);
  }
  .archive-link:hover {
    border-color: var(--text);
  }
  :global(.archive-arrow) {
    width: 16px;
    height: 16px;
  }
</style>
