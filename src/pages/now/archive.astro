---
import Section from '../../layouts/Section.astro';
import Arrow from '../../components/Arrow.astro';
import { getNowUpdates, formatDate } from '../../lib/content';

const [, ...archived] = await getNowUpdates();
---

<Section
  section="now"
  heading="Now archive"
  intro="Snapshots of what I was focused on, from newest to oldest."
  description="Past versions of Cameron Williams's Now page."
>
  <a slot="eyebrow" class="back" href="/now">
    <Arrow direction="left" class="back-arrow" />
    Now
  </a>

  {
    archived.length === 0 ? (
      <p class="empty">No past updates yet.</p>
    ) : (
      <ol class="list">
        {archived.map((entry) => (
          <li>
            <a class="row" href={`/now/${entry.id}`}>
              <time class="date mono" datetime={entry.data.updated.toISOString()}>
                {formatDate(entry.data.updated)}
              </time>
              <span class="focus">{entry.data.focus}</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Section>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.back-arrow) {
    width: 14px;
    height: 14px;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    gap: 4px 24px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }
  li:last-child .row {
    border-bottom: 1px solid var(--border);
  }
  .date {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
  }
  .focus {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    transition: color 0.2s;
  }
  .row:hover .focus {
    color: var(--muted);
  }
  @media (min-width: 720px) {
    .row {
      grid-template-columns: 180px 1fr;
      align-items: baseline;
    }
  }
</style>
