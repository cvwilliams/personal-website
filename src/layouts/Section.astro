---
import Base from './Base.astro';
import SectionArt from '../components/SectionArt.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/page.css';
import { site, sections, type Section } from '../data/site';

interface Props {
  section: Section;
  heading: string;
  eyebrow?: string;
  intro?: string;
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const { section, heading, eyebrow, intro, title, description, ogType } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const isSectionIndex = sections.some((s) => s.id === section && s.href === path);
---

<Base title={title ?? heading} description={description ?? intro} ogType={ogType} section={section}>
  <script is:inline slot="head" define:vars={{ section, isSectionIndex }}>
    (() => {
      const isHome = (url) => {
        const target = new URL(url, location.href);
        return target.origin === location.origin && (target.pathname === '/' || target.pathname === '/index.html');
      };
      const name = () => {
        const hero = document.querySelector('.page .hero');
        if (!hero) return;
        hero.style.setProperty('view-transition-name', `field-${section}`);
        hero.querySelector('.hero-art')?.style.setProperty('view-transition-name', `art-${section}`);
        hero.querySelector('.hero-text')?.style.setProperty('view-transition-name', 'hero-text');
        if (isSectionIndex) hero.querySelector('h1')?.style.setProperty('view-transition-name', `title-${section}`);
      };
      const clear = () =>
        document
          .querySelectorAll('.page .hero, .page .hero *')
          .forEach((el) => el.style.removeProperty('view-transition-name'));
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (link && !event.defaultPrevented && isHome(link.href)) name();
      });
      addEventListener('pageswap', (event) => {
        const url = event.activation?.entry?.url;
        if (event.viewTransition && url && isHome(url)) name();
      });
      addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        const navigation = /** @type {any} */ (window).navigation;
        const from = navigation?.activation?.from?.url ?? document.referrer;
        if (from && isHome(from)) name();
        event.viewTransition.finished.finally(clear);
      });
    })();
  </script>
  <div class="page" data-section={section}>
    <header class="site-header">
      <a class="home-link" href="/">{site.name}</a>
      <div class="header-end">
      <nav aria-label="Sections">
        <ul>
          {
            sections.map((s) => (
              <li>
                <a
                  href={s.href}
                  data-section={s.id}
                  aria-current={path === s.href ? 'page' : s.id === section ? 'true' : undefined}
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
      </div>
    </header>

    <main id="main" class="page-main" tabindex="-1">
      <div class="hero grain">
        <div class="hero-text">
          {
            (eyebrow || Astro.slots.has('eyebrow')) && (
              <p class="eyebrow">
                <slot name="eyebrow">{eyebrow}</slot>
              </p>
            )
          }
          <h1>{heading}</h1>
          {intro && <p class="hero-intro">{intro}</p>}
          <slot name="hero" />
        </div>
        <SectionArt section={section} class="hero-art" />
      </div>

      <slot />
    </main>

    <SiteFooter />
  </div>
</Base>
