---
import '@fontsource-variable/libre-franklin';
import '../styles/global.css';
import faviconSvg from '../assets/icons/favicon.svg?url';
import faviconIco from '../assets/icons/favicon.ico?url';
import appleTouchIcon from '../assets/icons/apple-touch-icon.png?url';
import ogHome from '../assets/og/og-home.jpg?url';
import ogNow from '../assets/og/og-now.jpg?url';
import ogProjects from '../assets/og/og-projects.jpg?url';
import ogThoughts from '../assets/og/og-thoughts.jpg?url';
import ogResume from '../assets/og/og-resume.jpg?url';
import { site, sections, type Section } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  section?: Section;
  skipLink?: boolean;
}

const { title, description = site.description, ogType = 'website', section, skipLink = true } = Astro.props;
const ogImages: Record<Section, string> = {
  now: ogNow,
  projects: ogProjects,
  thoughts: ogThoughts,
  resume: ogResume,
};
const ogImage = new URL(section ? ogImages[section] : ogHome, Astro.site);
const ogImageAlt = section
  ? `${sections.find((s) => s.id === section)?.label} · ${site.name}`
  : `${site.name}: Now, Projects, Thoughts and Resume`;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="expect" href="#main" blocking="render" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={faviconIco} sizes="32x32" />
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Thoughts`} href="/rss.xml" />
    <meta name="theme-color" content="#f2ede4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <slot name="head" />
  </head>
  <body>
    {skipLink && <a class="skip-link" href="#main">Skip to content</a>}
    <slot />
    <script is:inline>
      (() => {
        const KEY = 'art-state';
        let state = {};
        try {
          state = JSON.parse(sessionStorage.getItem(KEY) || '{}');
        } catch {}
        const pick = (min, max) => +(min + Math.random() * (max - min)).toFixed(3);
        const shapesOf = (svg) => [...svg.querySelectorAll('rect, circle, path')];
        const colorOf = (el) => [...el.classList].find((c) => c.startsWith('f-') && c !== 'f-on');
        let changed = false;

        document.querySelectorAll('svg[data-art]').forEach((svg) => {
          const section = svg.dataset.art;
          let art = state[section];
          if (!art) {
            if (!svg.classList.contains('tile-art')) return;
            const palette = [...new Set(shapesOf(svg).map(colorOf).filter(Boolean))];
            const shuffled = [...palette].sort(() => Math.random() - 0.5);
            art = {
              colors: Object.fromEntries(palette.map((c, i) => [c, shuffled[i]])),
              x: pick(-12, 12),
              y: pick(-12, 12),
              r: pick(-7, 7),
              s: pick(0.94, 1.06),
              drags: {},
            };
            state[section] = art;
            changed = true;
          }
          shapesOf(svg).forEach((el, i) => {
            el.dataset.i = String(i);
            const from = colorOf(el);
            if (from && art.colors[from]) el.classList.replace(from, art.colors[from]);
            const drag = art.drags[i];
            if (drag) {
              el.style.setProperty('translate', `${drag[0]}px ${drag[1]}px`);
              el.dataset.dx = String(drag[0]);
              el.dataset.dy = String(drag[1]);
            }
          });
          svg.style.setProperty('--art-x', `${art.x}px`);
          svg.style.setProperty('--art-y', `${art.y}px`);
          svg.style.setProperty('--art-r', `${art.r}deg`);
          svg.style.setProperty('--art-s', String(art.s));
        });

        if (changed) {
          try {
            sessionStorage.setItem(KEY, JSON.stringify(state));
          } catch {}
        }
      })();
    </script>
  </body>
</html>
