---
interface Props {
  class?: string;
  direction?: 'up-right' | 'left';
}
const { class: className, direction = 'up-right' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {direction === 'up-right' ? <path d="M7 17L17 7M8 7h9v9" /> : <path d="M19 12H5M11 6l-6 6 6 6" />}
</svg>
