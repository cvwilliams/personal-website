---
import { getCollection } from 'astro:content';
import Listening from './Listening.astro';
import { favoriteBooks } from '../data/favorite-books';

const synced = new Map((await getCollection('favoriteBooks')).map((entry) => [entry.id, entry.data]));
const items = favoriteBooks.map((book, index) => {
  const match = synced.get(String(index));
  return { title: book.title, subtitle: book.author, url: match?.url, artwork: match?.cover };
});
---

<Listening items={items} heading="Favorite books" showKind={false} ordered={false} shape="book" />
