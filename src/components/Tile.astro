---
import type { Section } from '../data/site';
import SectionArt from './SectionArt.astro';
import Arrow from './Arrow.astro';

interface Props {
  section: Section;
  href: string;
  title: string;
}

const { section, href, title } = Astro.props;
const titleId = `tile-${section}-title`;
const bodyId = `tile-${section}-body`;
---

<a class="tile grain" href={href} data-section={section} aria-labelledby={titleId} aria-describedby={bodyId}>
  <SectionArt section={section} class="tile-art" />
  <div class="tile-head">
    <h2 id={titleId}>{title}</h2>
    <Arrow class="tile-arrow" />
  </div>
  <div class="tile-body" id={bodyId}>
    <slot />
  </div>
</a>
