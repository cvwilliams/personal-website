---
import { site } from '../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const links = [
  { label: 'GitHub', href: site.links.github, me: true },
  { label: 'LinkedIn', href: site.links.linkedin, me: true },
  { label: 'Email', href: site.links.email ? `mailto:${site.links.email}` : '' },
  { label: 'RSS', href: '/rss.xml' },
].filter((l) => l.href);

const year = new Date().getFullYear();
---

<footer class:list={['site-footer', className]}>
  <small>© {year} {site.name}</small>
  <ul>
    {
      links.map((l) => (
        <li>
          <a href={l.href} rel={'me' in l ? 'me' : undefined}>{l.label}</a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 32px 24px 48px;
    font-family: var(--font-label);
    font-size: 0.75rem;
    color: var(--muted);
  }
  small {
    font-size: inherit;
  }
  ul {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-block;
    padding: 4px 0;
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
